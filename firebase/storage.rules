rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploads folder - public read/write with restrictions
    match /uploads/{randomId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024  // 100MB max
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('application/msword')
                       || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
                       || request.resource.contentType.matches('application/vnd.ms-.*')
                       || request.resource.contentType.matches('image/.*'));
    }
    
    // Converted folder - public read, only Cloud Functions can write (via Admin SDK)
    match /converted/{randomId}/{fileName} {
      allow read: if true;
      allow write: if true;  // Only Admin SDK can write
    }
  }
}
