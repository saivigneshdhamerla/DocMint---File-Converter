rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stats collection - public read for displaying on homepage
    match /stats/{document=**} {
      allow read: if true;
      allow write: if false;  // Only Admin SDK can write
    }
    
    // Rate limits collection - readable for checking limits
    match /rateLimits/{ipHash} {
      allow read: if true;
      allow write: if false;  // Only Admin SDK can write
    }
    
    // Conversion history (optional, for future features)
    match /conversions/{conversionId} {
      allow read: if true;
      allow write: if false;  // Only Admin SDK can write
    }
    
    // Block all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
